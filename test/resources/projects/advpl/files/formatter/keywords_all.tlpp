 interface IFoo
 	method bar()
 endinterface

 class Derived implements IFoo
 	data cName as character
 	method newObj() constructor
 	method doIt()
 endclass

method newObj() class Derived
return self

method doIt() class Derived
return

 wsrestful MyService
 	wsdata id as integer
 	wsmethod get doGet()
 end wsrestful

 wsmethod get doGet() wsrestful MyService
 return

User Function ExemploTran()
    Local lOk := .T.

     Inicia a transação com o banco de dados
    BEGIN TRANSACTION

         Exemplo de operação na tabela SB1 (Produtos)
        RecLock("SB1", .F.)
            SB1->B1_DESC := "NOVA DESCRICAO DO PRODUTO"
        SB1->(MsUnLock())

         Simulando uma condição de erro
        If /* alguma condição de falha */ .F.
            lOk := .F.
        EndIf

         Se ocorreu algum erro, desfaz as alterações (Rollback)
        If !lOk
            DisarmTransaction()
            Break
        EndIf

     Finaliza a transação
    END TRANSACTION

    If lOk
        MsgInfo("Transação gravada com sucesso!", "Atenção")
    Else
        MsgStop("A transação foi desfeita devido a um erro.", "Erro")
    EndIf

Return
