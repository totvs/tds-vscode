//  Fixture de cobertura de palavras-chave da gramatica tlpp (nos "kw_*").
//  Codigo SEM logica precisa: objetivo e exercitar o maior numero possivel de
//  palavras-chave em construcoes TLPP validas (parse sem ERROR), para os testes
//  de formatacao (keywordsCase, indentacao etc.).

//  Observacao: varias palavras-chave da gramatica NAO sao alcancaveis como
//  no "kw_*" em codigo escrevivel e por isso nao aparecem aqui:
//   - keywords de SQL embarcado (select/from/where/join/group by/order by/...):
//     dentro de "beginsql ... endsql" o conteudo e capturado como texto cru
//     ("beginsql_body"), nao como nos kw_*.
//   - nos internos da gramatica (obj_new_class, obj_class_data, stk_var_def,
//     annotation_decl/end, ...): representacoes internas, sem token literal.
#include "protheus.ch"

using namespace My.Space

user function allKeywords()
	local nX := 1
	private nY := 2
	public nZ := 3
	static nW := 4
	default nX := 10

	if nX > 0 .and. nY < 10 .or. nZ == 3
		nX := iif(nX > 0, 1, 2)
	elseif nX < 0
		nX := nil
	else
		nX := 0
	endif

	do case
		case nX == 1
			nX := 1
		otherwise
			nX := 2
	endcase

	while nX < 10
		nX++
		if nX == 5
			loop
		endif
		if nX == 9
			exit
		endif
	enddo

	for nX := 1 to 10 step 2
		nY := nX
	next

	 foreach nItem in aList
	 	if nItem == nil
	 		continueforeach
	 	endif
	 	if nItem > 100
	 		exitforeach
	 	endif
	 endforeach

	begin sequence
		break
	recover
		nX := -1
	end sequence

	try
		nX := 1
	catch oErr
		nX := 2
	finally
		nX := 3
	endtry

	begin work
		nX := 1
	commit work

return nX

