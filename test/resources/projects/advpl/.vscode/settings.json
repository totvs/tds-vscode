{
    "totvsLanguageServer.welcomePage": false,
    "totvsLanguageServer.editor.linter.includes": "m:\\protheus\\INCLUDES;m:\\protheus\\INCLUDES_TLPP",
    "totvsLanguageServer.editor.show.notification": "all",
    "totvsLanguageServer.trace.debug": "messages",
    "totvsLanguageServer.trace.server": "verbose",
    "totvsLanguageServer.launch.args": [
        "--log-file=totvsls.log",
        "--verbose",
        "--wait-for-attach=90",
        "--debug-ls",
        "--trace-compile",
        "--log-file-append=totvsls2.log"
    ],
    "totvsLanguageServer.askCompileResult": false,
    "totvsLanguageServer.askEncodingChange": false,
    "totvsLanguageServer.editor.autocomplete": "Off",
    "totvsLanguageServer.compilation.generatePpoFile": false,
    "totvsLanguageServer.workspaceServerConfig": false,
    "totvsLanguageServer.editor.hover": "off",
    "editor.formatOnSave": false,
    "advpl.formatter": {
        "_maxConsecutiveBlankLines": 1,
        "_xalignAssignments": true,
        "_xmaxLineLength": 90,
        "_xcommentReflow": true,
        "_keywordsCase": "ignore",
        "_stringStyle": "single-quotes",
        "trimTrailingWhitespace": true,
        "operatorSpacing": false,
        "preserveSingleLineBlocks": false,
        "spaceAfterComma": true
    },
    "totvsLanguageServer.editor.signatureHelp": false,
    "totvsLanguageServer.editor.codeLens": false,
    "editor.codeLens": true,
    "totvsLanguageServer.linter.callTreeSitter": true,
    "editor.signatureHelp.enabled": true,
    "totvsLanguageServer.editor.codeActions": false
}