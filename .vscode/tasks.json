{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"label": "npm",
			"script": "watch",
			"problemMatcher": [
				"$tsc-watch",
				"$esbuild-watch"
			],
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "compile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "tds-kiro: build",
			"type": "shell",
			"command": "npm run dev",
			"options": {
				"cwd": "w:/tds/tds-kiro"
			},
			"problemMatcher": []
		},
		{
			"label": "compile: tds-vscode + tds-kiro",
			"dependsOn": [
				"npm: compile",
				"tds-kiro: build"
			],
			"dependsOrder": "parallel",
			"problemMatcher": []
		},
		{
			"type": "npm",
			"script": "clean-logs",
			"problemMatcher": [],
			"label": "npm: clean-logs",
			"detail": "gulp cleanLogs"
		}
	]
}