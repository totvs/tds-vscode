{
	"version": "0.2.0",
	"configurations": [
		{
			"args": [
				"task"
			],
			"name": "Gulp task",
			"program": "${workspaceFolder}/node_modules/gulp/bin/gulp.js",
			"request": "launch",
			"skipFiles": [
				"<node_internals>/**"
			],
			"type": "node"
		},
		{
			"type": "extensionHost",
			"request": "launch",
			"name": "Extension",
			"runtimeExecutable": "${execPath}",
			"args": [
				"${workspaceFolder}/test/resources/projects/advpl",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--inspect",
				"--user-data-dir=${env:USERPROFILE}/AppData/Roaming/Code"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"sourceMaps": true,
			"preLaunchTask": "npm: compile",
			"env": {
				"TOTVS_LS_LOG_FILE": "./TOTVS_LS_LOG_FILE.log"
			}
		},
		{
			"type": "extensionHost",
			"request": "launch",
			"name": "Extension + TDS Kiro",
			"runtimeExecutable": "${execPath}",
			"args": [
				"${workspaceFolder}/test/resources/projects/advpl",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--extensionDevelopmentPath=w:\\tds\\tds-kiro",
				"--inspect",
				"--user-data-dir=${env:USERPROFILE}/AppData/Roaming/Code"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js",
				"w:/tds/tds-kiro/dist/**/*.js"
			],
			"sourceMapPathOverrides": {
				"../src/*": "w:/tds/tds-kiro/src/*"
			},
			"sourceMaps": true,
			"preLaunchTask": "compile: tds-vscode + tds-kiro",
			"env": {
				"TOTVS_LS_LOG_FILE": "./TOTVS_LS_LOG_FILE.log"
			}
		},
		{
			"type": "extensionHost",
			"request": "launch",
			"name": "Extension WithoutCompile",
			"runtimeExecutable": "${execPath}",
			"args": [
				"${workspaceFolder}/test/resources/projects/advpl",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--inspect",
				"--user-data-dir=${env:USERPROFILE}/AppData/Roaming/Code"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"env": {
				"TOTVS_LS_LOG_FILE": "./TOTVS_LS_LOG_FILE.log"
			}
		},
		{
			"type": "extensionHost",
			"request": "launch",
			"name": "TLPP Core",
			"runtimeExecutable": "${execPath}",
			"args": [
				"W:\\tlpp-core\\tlpp-core",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--inspect"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"sourceMaps": true,
			"preLaunchTask": "",
			"env": {
				"TOTVS_LS_LOG_FILE": "./TOTVS_LS_LOG_FILE.log"
			}
		},
		{
			"type": "extensionHost",
			"request": "launch",
			"name": "advpl",
			"runtimeExecutable": "${execPath}",
			"args": [
				"${workspaceFolder}/test/resources/projects/advpl",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--inspect"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"sourceMaps": true,
			"preLaunchTask": "",
			"env": {
				"TOTVS_LS_LOG_FILE": "./TOTVS_LS_LOG_FILE.log"
			}
		}
	]
}